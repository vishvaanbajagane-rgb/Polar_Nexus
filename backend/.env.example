# ---------- Database (PostgreSQL 15, native) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polar_nexus
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ---------- Security ----------
SECRET_KEY=change-me-super-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- CORS ----------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- MapTiler ----------
MAPTILER_API_KEY=lBIA21m3wp6Pjwj3WrDX

# ---------- Bootstrap admin ----------
ADMIN_EMAIL=admin@polarnexus.gov.in
ADMIN_PASSWORD=PolarNexus@Admin2026!SecureKey#9876
ADMIN_FULL_NAME=Polar Nexus Administrator

# ---------- Redis 7 / Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# ---------- Scheduler (APScheduler, UTC) ----------
ENABLE_SCHEDULER=true
DAILY_UPDATE_HOUR=2
DAILY_UPDATE_MINUTE=30

# ---------- External APIs ----------
NSIDC_API_URL=https://nsidc.org/api
NOAA_API_URL=https://www.ncei.noaa.gov/access/services/data/v1
ORCID_API_URL=https://pub.orcid.org/v3.0
CROSSREF_API_URL=https://api.crossref.org
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
